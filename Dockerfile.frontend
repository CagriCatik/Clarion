FROM node:20-slim

WORKDIR /app

# Copy package files (context is root, so we access frontend/)
COPY frontend/package.json ./

# Install dependencies
RUN npm install

# Copy source code (flattening frontend/ content into /app)
COPY frontend/ .

# Expose Vite port relative to host
EXPOSE 5173

# Run vite with host flag to allow external access
CMD ["npm", "run", "dev", "--", "--host"]
